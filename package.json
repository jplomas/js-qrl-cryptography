{
  "name": "@theqrl/qrl-cryptography",
  "version": "0.2.0",
  "description": "All the cryptographic primitives used in QRL",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theQRL/js-qrl-cryptography.git"
  },
  "license": "MIT",
  "main": "./dist/cjs/index.js",
  "module": "./dist/mjs/index.js",
  "types": "./dist/mjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mjs/index.d.ts",
      "import": "./dist/mjs/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./aes": {
      "types": "./dist/mjs/aes.d.ts",
      "import": "./dist/mjs/aes.js",
      "require": "./dist/cjs/aes.js"
    },
    "./aes.js": {
      "types": "./dist/mjs/aes.d.ts",
      "import": "./dist/mjs/aes.js",
      "require": "./dist/cjs/aes.js"
    },
    "./argon2id": {
      "types": "./dist/mjs/argon2id.d.ts",
      "import": "./dist/mjs/argon2id.js",
      "require": "./dist/cjs/argon2id.js"
    },
    "./argon2id.js": {
      "types": "./dist/mjs/argon2id.d.ts",
      "import": "./dist/mjs/argon2id.js",
      "require": "./dist/cjs/argon2id.js"
    },
    "./keccak": {
      "types": "./dist/mjs/keccak.d.ts",
      "import": "./dist/mjs/keccak.js",
      "require": "./dist/cjs/keccak.js"
    },
    "./keccak.js": {
      "types": "./dist/mjs/keccak.d.ts",
      "import": "./dist/mjs/keccak.js",
      "require": "./dist/cjs/keccak.js"
    },
    "./ml_dsa87": {
      "types": "./dist/mjs/ml_dsa87.d.ts",
      "import": "./dist/mjs/ml_dsa87.js",
      "require": "./dist/cjs/ml_dsa87.js"
    },
    "./ml_dsa87.js": {
      "types": "./dist/mjs/ml_dsa87.d.ts",
      "import": "./dist/mjs/ml_dsa87.js",
      "require": "./dist/cjs/ml_dsa87.js"
    },
    "./random": {
      "types": "./dist/mjs/random.d.ts",
      "import": "./dist/mjs/random.js",
      "require": "./dist/cjs/random.js"
    },
    "./random.js": {
      "types": "./dist/mjs/random.d.ts",
      "import": "./dist/mjs/random.js",
      "require": "./dist/cjs/random.js"
    },
    "./utils": {
      "types": "./dist/mjs/utils.d.ts",
      "import": "./dist/mjs/utils.js",
      "require": "./dist/cjs/utils.js"
    },
    "./utils.js": {
      "types": "./dist/mjs/utils.d.ts",
      "import": "./dist/mjs/utils.js",
      "require": "./dist/cjs/utils.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "typesVersions": {
    "*": {
      "aes": [
        "./dist/mjs/aes.d.ts"
      ],
      "aes.js": [
        "./dist/mjs/aes.d.ts"
      ],
      "argon2id": [
        "./dist/mjs/argon2id.d.ts"
      ],
      "argon2id.js": [
        "./dist/mjs/argon2id.d.ts"
      ],
      "keccak": [
        "./dist/mjs/keccak.d.ts"
      ],
      "keccak.js": [
        "./dist/mjs/keccak.d.ts"
      ],
      "ml_dsa87": [
        "./dist/mjs/ml_dsa87.d.ts"
      ],
      "ml_dsa87.js": [
        "./dist/mjs/ml_dsa87.d.ts"
      ],
      "random": [
        "./dist/mjs/random.d.ts"
      ],
      "random.js": [
        "./dist/mjs/random.d.ts"
      ],
      "utils": [
        "./dist/mjs/utils.d.ts"
      ],
      "utils.js": [
        "./dist/mjs/utils.d.ts"
      ]
    }
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@noble/hashes": "2.2.0",
    "@theqrl/mldsa87": "2.1.3"
  },
  "browser": {
    "crypto": false
  },
  "sideEffects": false,
  "scripts": {
    "build": "npm-run-all build:mjs build:cjs build:fixup",
    "build:mjs": "tsc --project tsconfig.prod.json",
    "build:cjs": "rollup -c rollup.config.mjs",
    "build:fixup": "bash ./scripts/fixup-dist.sh",
    "prepublishOnly": "npm run build",
    "test": "npm-run-all test:node",
    "test:node": "mocha",
    "coverage": "c8 npm run test",
    "report-coverage": "c8 --reporter=lcovonly --reporter=text-summary npm run test",
    "clean": "rimraf test-builds dist coverage",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "browser-tests": "npm-run-all browser-tests:build browser-tests:test",
    "browser-tests:build": "bash ./scripts/build-browser-tests.sh",
    "browser-tests:test": "playwright test",
    "test:packaging": "node scripts/packaging-smoke.mjs",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "10.0.1",
    "@types/estree": "1.0.9",
    "@types/mocha": "10.0.10",
    "@types/node": "26.0.1",
    "@typescript-eslint/eslint-plugin": "8.62.0",
    "@typescript-eslint/parser": "8.62.0",
    "c8": "11.0.0",
    "conventional-changelog-conventionalcommits": "10.2.0",
    "eslint": "10.6.0",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.7.0",
    "mocha": "11.7.6",
    "monocart-coverage-reports": "2.12.12",
    "npm-run-all": "4.1.5",
    "parcel": "2.16.4",
    "playwright": "1.61.1",
    "prettier": "3.9.1",
    "rimraf": "6.1.3",
    "rollup": "4.62.2",
    "semantic-release": "25.0.5",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "webpack": "5.108.1",
    "webpack-cli": "7.1.0"
  },
  "c8": {
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "scripts/**",
      "dist/**",
      "test/**",
      "test-builds/**"
    ],
    "all": true,
    "src": [
      "src"
    ],
    "experimental-monocart": true,
    "check-coverage": true,
    "statements": 100,
    "branches": 100,
    "functions": 100,
    "lines": 100
  },
  "overrides": {
    "serialize-javascript": "7.0.5",
    "minimatch": "10.2.5",
    "glob": "13.0.6",
    "tar": "7.5.16",
    "diff": "8.0.3",
    "picomatch": "4.0.4",
    "brace-expansion": "5.0.6",
    "shell-quote": "1.8.4",
    "npm": "11.18.0",
    "esbuild": "0.28.1"
  },
  "keywords": [
    "qrl",
    "cryptography",
    "digital signature",
    "hash",
    "encryption",
    "prng",
    "keccak",
    "argon2id",
    "aes",
    "advanced encryption standard"
  ],
  "targets": {
    "parcel_tests": {
      "context": "browser"
    }
  }
}
