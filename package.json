{
  "name": "@theqrl/qrl-cryptography",
  "version": "0.1.1",
  "description": "All the cryptographic primitives used in QRL",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theQRL/js-qrl-cryptography.git"
  },
  "license": "MIT",
  "main": "./dist/cjs/index.js",
  "module": "./dist/mjs/index.js",
  "types": "./dist/mjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mjs/index.d.ts",
      "import": "./dist/mjs/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./aes": {
      "types": "./dist/mjs/aes.d.ts",
      "import": "./dist/mjs/aes.js",
      "require": "./dist/cjs/aes.js"
    },
    "./argon2id": {
      "types": "./dist/mjs/argon2id.d.ts",
      "import": "./dist/mjs/argon2id.js",
      "require": "./dist/cjs/argon2id.js"
    },
    "./keccak": {
      "types": "./dist/mjs/keccak.d.ts",
      "import": "./dist/mjs/keccak.js",
      "require": "./dist/cjs/keccak.js"
    },
    "./ml_dsa87": {
      "types": "./dist/mjs/ml_dsa87.d.ts",
      "import": "./dist/mjs/ml_dsa87.js",
      "require": "./dist/cjs/ml_dsa87.js"
    },
    "./random": {
      "types": "./dist/mjs/random.d.ts",
      "import": "./dist/mjs/random.js",
      "require": "./dist/cjs/random.js"
    },
    "./utils": {
      "types": "./dist/mjs/utils.d.ts",
      "import": "./dist/mjs/utils.js",
      "require": "./dist/cjs/utils.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@theqrl/mldsa87": "2.0.4"
  },
  "browser": {
    "crypto": false
  },
  "sideEffects": false,
  "scripts": {
    "build": "npm-run-all build:mjs build:cjs build:fixup",
    "build:mjs": "tsc --project tsconfig.prod.json",
    "build:cjs": "rollup -c rollup.config.mjs",
    "build:fixup": "bash ./scripts/fixup-dist.sh",
    "prepublishOnly": "npm run build",
    "test": "npm-run-all test:node",
    "test:node": "mocha",
    "coverage": "c8 npm run test",
    "report-coverage": "c8 --reporter=lcovonly --reporter=text-summary npm run test",
    "clean": "rimraf test-builds dist coverage",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "browser-tests": "npm-run-all browser-tests:build browser-tests:test",
    "browser-tests:build": "bash -x ./scripts/build-browser-tests.sh",
    "browser-tests:test": "playwright test",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@rollup/plugin-commonjs": "29.0.2",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "10.0.1",
    "@types/estree": "1.0.9",
    "@types/mocha": "9.1.1",
    "@types/node": "25.6.2",
    "@typescript-eslint/eslint-plugin": "8.59.2",
    "@typescript-eslint/parser": "8.59.2",
    "c8": "11.0.0",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint": "10.3.0",
    "eslint-plugin-prettier": "5.5.5",
    "mocha": "11.7.5",
    "npm-run-all": "4.1.5",
    "parcel": "2.16.4",
    "playwright": "1.59.1",
    "prettier": "3.8.3",
    "rimraf": "6.1.3",
    "rollup": "4.60.3",
    "semantic-release": "25.0.3",
    "tsx": "^4.21.0",
    "typescript": "6.0.3",
    "webpack": "5.106.2",
    "webpack-cli": "7.0.2"
  },
  "c8": {
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "scripts/**",
      "dist/**",
      "test/**",
      "test-builds/**"
    ],
    "all": true,
    "src": [
      "src"
    ]
  },
  "overrides": {
    "serialize-javascript": "7.0.5",
    "minimatch": "10.2.4",
    "glob": "13.0.6",
    "tar": "7.5.11",
    "diff": "8.0.3",
    "picomatch": "4.0.4",
    "brace-expansion": "5.0.5"
  },
  "keywords": [
    "qrl",
    "cryptography",
    "digital signature",
    "hash",
    "encryption",
    "prng",
    "keccak",
    "argon2id",
    "aes",
    "advanced encryption standar"
  ],
  "targets": {
    "parcel_tests": {
      "context": "browser"
    }
  }
}
